# ==============================================================================
# BrandProof AI - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Single Gemini API Key Configuration
# Strictly one key, no key rotation, no key pools, no fallback keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (PostgreSQL Database & Auth)
# Note: Keep the SUPABASE_SERVICE_ROLE_KEY strictly on the backend!
# ------------------------------------------------------------------------------
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ------------------------------------------------------------------------------
# 3. S3-Compatible Image Storage Configuration
# Supports AWS S3, Cloudflare R2, MinIO, Wasabi, DigitalOcean Spaces
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL=your_s3_endpoint
S3_REGION=your_s3_region
S3_BUCKET_NAME=your_bucket_name
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_USE_SSL=true

# ------------------------------------------------------------------------------
# 4. Processing Limits & OCR Settings
# ------------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
MAX_TEXT_LENGTH=50000
OCR_ENGINE=paddleocr
OCR_LANG=en
OCR_USE_GPU=false

# ------------------------------------------------------------------------------
# 5. Groq Speech-to-Text & Multimedia Processing
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3-turbo
# Optional custom path to FFmpeg binary (automatically resolved if omitted)
# FFMPEG_BINARY=C:\ffmpeg\bin\ffmpeg.exe
